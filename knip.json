{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/routeTree.gen.ts",
    "src/router.tsx",
    "src/start.ts",
    "scripts/**/*.ts",
    "tests/**/*.{ts,tsx}",
    "prisma/**/*.ts",
    "mcp/**/*.ts",
    "prisma.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "tests/**/*.{ts,tsx}",
    "prisma/**/*.ts",
    "mcp/**/*.ts"
  ],
  "ignoreIssues": {
    "src/components/ui/**": ["exports"],
    "src/generated/**": ["files", "exports", "types"],
    "src/paraglide/**": ["files", "exports"]
  },
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css",
    "@tailwindcss/typography",
    "@fontsource/fraunces",
    "@fontsource/manrope"
  ],
  "ignoreBinaries": ["run", "k6"],
  "ignoreExportsUsedInFile": true
}
