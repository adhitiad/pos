# Database
# Lokal:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos
# Neon (contoh): isi dari Dashboard > Connection string.
#   DATABASE_URL=postgresql://<user>:<pass>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
#   DATABASE_URL_UNPOOLED=postgresql://<user>:<pass>@<host>.<region>.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED = koneksi langsung (tanpa "-pooler"), dipakai `db:push`/
# `db:seed`/migrasi. Wajib diisi saat pakai Neon agar DDL tak lewat PgBouncer.
# DATABASE_URL_UNPOOLED=

# Read replica (opsional) untuk query baca (laporan, dasbor). Bila kosong, fallback
# ke DATABASE_URL → satu database tunggal.
#   DATABASE_URL_READ=postgresql://<user>:<pass>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_READ=
# Database terpisah untuk `bun run db:migrate:drift` (dikosongkan Prisma).
# SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_shadow

# Pool & timeout runtime (opsional; default di bawah).
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=15000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # openssl rand -base64 32 (min 32 chars)

# Google OAuth (dari Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Client ID OAuth native (iOS/Android) untuk /api/v1/auth-native.
# Harus BERBEDA dari GOOGLE_CLIENT_ID. Kosong = login native 503.
GOOGLE_NATIVE_CLIENT_ID=

# Roles — pisahkan email dengan koma
OWNER_EMAILS= # otomatis jadi OWNER
KASIR_EMAILS= # jadi KASIR (bukan OWNER)

# Trusted origins untuk production (comma-separated, termasuk http://localhost:3000 untuk dev)
# Tambahkan origin Expo Web bila memakai build web/react-native-web:
#   http://localhost:8081 (Expo dev), http://localhost:19006 (Expo web dev)
# Klien native (Android/iOS) TIDAK mengirim Origin → tak perlu masuk daftar ini.
TRUSTED_ORIGINS=http://localhost:3000

# Percayai header X-Forwarded-For (isi "true" HANYA di belakang proxy tepercaya).
# PENTING (OW-15/SEC-20): XFF dibaca dari KANAN, bukan entri pertama yang bisa
# dipalsukan klien. TRUST_PROXY_HOPS = jumlah proxy tepercaya yang menambahkan XFF;
# Vercel = 1. Naikkan bila ada CDN/reverse proxy tambahan. Tanpa proxy, biarkan
# "false" agar semua klien tidak berbagi satu bucket.
# Di Vercel (VERCEL=1) nilai kosong otomatis dianggap "true"; set "false" untuk
# mematikan IP tracking secara eksplisit.
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
# Paksa CSP menyala (true/1) atau mati (false/0); kosong = menyala saat produksi.
# Mematikan CSP di produksi (false) akan memunculkan peringatan di log (OW-04).
ENABLE_CSP=

# Level log pino: trace|debug|info|warn|error|fatal. Kosong = debug di dev, info di produksi.
LOG_LEVEL=

# Cloudinary — HANYA di server. Server membuat tanda tangan upload; klien mengunggah
# ke Cloudinary memakai tanda tangan itu, dan unduh/hapus diproses server.
# JANGAN pernah menaruh API key/secret di klien (tanpa prefix VITE_).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder khusus aset POS (default "pos/produk"). Hanya publicId di dalam folder ini
# yang boleh dihapus/diunduh lewat server.
CLOUDINARY_FOLDER=pos/produk

# Webhook pembayaran (payment gateway mendatang). Kosong = endpoint
# /api/v1/pembayaran/webhook menolak semua permintaan. Minimal 16 karakter.
PAYMENT_WEBHOOK_SECRET=

# Secret route cron (/api/cron/*). Di Vercel, isi CRON_SECRET agar Vercel
# otomatis mengirim header Authorization: Bearer <nilai>. Kosong = cron mati.
# Minimal 16 karakter; pakai nilai acak (mis. `openssl rand -hex 32`).
CRON_SECRET=

# Webhook opsional untuk alert fraud (pembatalan pesanan, retur, perubahan
# pajak/mode review). Kosong = alert hanya masuk log pino level warn.
FRAUD_WEBHOOK_URL=

# ── Upstash Redis (rate limiting login/logout, caching search) ─────────
# Dari Upstash Dashboard > Redis > REST API. Bila dikosongkan, rate limiter
# fallback ke PostgreSQL token bucket (funsi `batasi` di rateLimit.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── QStash (cron scheduling & background tasks) ───────────────────────
# QStash menggantikan (atau melengkapi) Vercel Crons untuk task yang butuh
# retry otomatis dan dead-letter queue. Dari Upstash Dashboard > QStash.
# Kosong = pakai Vercel Crons (CRON_SECRET) saja.
QSTASH_URL=https://qstash-upstash-com
QSTASH_TOKEN=
# Lingkungan QStash: development | production | wait-for-it (opsional).
QSTASH_CURRENT_ENV=
