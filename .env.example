# Database
# Lokal:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos
# Neon (contoh): isi dari Dashboard > Connection string.
#   DATABASE_URL=postgresql://<user>:<pass>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
#   DATABASE_URL_UNPOOLED=postgresql://<user>:<pass>@<host>.<region>.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED = koneksi langsung (tanpa "-pooler"), dipakai `db:push`/
# `db:seed`/migrasi. Wajib diisi saat pakai Neon agar DDL tak lewat PgBouncer.
# DATABASE_URL_UNPOOLED=
# Database terpisah untuk `bun run db:migrate:drift` (dikosongkan Prisma).
# SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_shadow
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # openssl rand -base64 32 (min 32 chars)

# Google OAuth (dari Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Roles — pisahkan email dengan koma
OWNER_EMAILS= # otomatis jadi OWNER
KASIR_EMAILS= # jadi KASIR (bukan OWNER)

# Trusted origins untuk production (comma-separated, termasuk http://localhost:3000 untuk dev)
# Tambahkan origin Expo Web bila memakai build web/react-native-web:
#   http://localhost:8081 (Expo dev), http://localhost:19006 (Expo web dev)
# Klien native (Android/iOS) TIDAK mengirim Origin → tak perlu masuk daftar ini.
TRUSTED_ORIGINS=http://localhost:3000

# Percayai header X-Forwarded-For/X-Real-IP (isi "true" HANYA di belakang proxy tepercaya).
# PENTING (OW-15): set "true" hanya bila proxy (Vercel/nginx) MENIMPA header ini; jika tidak,
# XFF bisa dipalsukan untuk melewati rate limit. Tanpa proxy, biarkan "false" agar semua
# klien tidak berbagi satu bucket.
TRUST_PROXY=false
# Paksa CSP menyala (true/1) atau mati (false/0); kosong = menyala saat produksi.
# Mematikan CSP di produksi (false) akan memunculkan peringatan di log (OW-04).
ENABLE_CSP=

# Level log pino: trace|debug|info|warn|error|fatal. Kosong = debug di dev, info di produksi.
LOG_LEVEL=

# Cloudinary — HANYA di server. Server membuat tanda tangan upload; klien mengunggah
# ke Cloudinary memakai tanda tangan itu, dan unduh/hapus diproses server.
# JANGAN pernah menaruh API key/secret di klien (tanpa prefix VITE_).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder khusus aset POS (default "pos/produk"). Hanya publicId di dalam folder ini
# yang boleh dihapus/diunduh lewat server.
CLOUDINARY_FOLDER=pos/produk
