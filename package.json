{
  "name": "pos",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "predev": "prisma generate && bun run docs:sync",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:vitest",
    "test:vitest": "dotenv run -f .env.local -- vitest run tests/vitest",
    "test:coverage": "dotenv run -f .env.local -- vitest run tests/vitest --coverage",
    "test:e2e": "playwright test tests/e2e",
    "test:load": "bun scripts/uji-beban.ts",
    "ci": "bun run typecheck && bun run lint && bun run check && bun run docs:check && bun run test:coverage && bun --bun run build && bun run perf:budget",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "docs:sync": "bun scripts/sinkron-dokumen.ts",
    "docs:check": "bun scripts/sinkron-dokumen.ts --check",
    "perf:budget": "bun scripts/cek-performa.ts",
    "audit": "bun audit",
    "post-cta-init": "bunx --bun create-db@latest --user-agent tanstack/tsrouter",
    "db:generate": "dotenv run -f .env.local -- prisma generate",
    "db:push": "dotenv run -f .env.local -- prisma db push",
    "db:migrate": "dotenv run -f .env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv run -f .env.local -- prisma migrate deploy",
    "db:migrate:status": "dotenv run -f .env.local -- prisma migrate status",
    "db:migrate:drift": "dotenv run -f .env.local -- prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "db:studio": "dotenv run -f .env.local -- prisma studio",
    "db:seed": "dotenv run -f .env.local -- prisma db seed",
    "db:reset": "bun run db:seed"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5",
    "@fontsource/manrope": "^5",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@react-pdf/renderer": "^4.9.0",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/store": "0.11.2",
    "@upstash/qstash": "^2.12.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.9",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260903-beta",
    "pino": "^10.4.0",
    "prisma": "^7.4.2",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@better-auth/core": "^1.7.14",
    "@inlang/paraglide-js": "^2.29.2",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/form-core": "^1.33.5",
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/w3c-web-serial": "^1.0.9",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "6",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss",
    "@prisma/engines",
    "prisma"
  ],
  "overrides": {
    "fast-uri": "^3.1.9"
  }
}