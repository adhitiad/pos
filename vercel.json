{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "installCommand": "bun install",
  "buildCommand": "NITRO_PRESET=vercel bun run build",
  "bunVersion": "1.x",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "cron": [
    {
      "path": "/api/cron/notifikasi-mingguan",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/backup-pitr",
      "schedule": "0 2 * * *"
    }
  ]
}
