generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                 @id
  name                   String
  email                  String                 @unique
  emailVerified          Boolean
  image                  String?
  role                   Role                   @default(MEMBER)
  createdAt              DateTime
  updatedAt              DateTime
  roleManual             Boolean                @default(false)
  deviceVisits           DeviceVisit[]
  pageVisits             PageVisit[]
  printers               Printer[]
  shifts                 Shift[]
  transaksiKasir         Transaksi[]
  accounts               Account[]
  auditLogs              AuditLog[]             @relation("AuditLogUser")
  draftTransaksiKasir    DraftTransaksi[]       @relation("DraftTransaksiKasir")
  draftTransaksiReviewer DraftTransaksi[]       @relation("DraftTransaksiReviewer")
  notifikasi             Notifikasi[]
  pengajuanKasir         PengajuanPengeluaran[]
  pengajuanOwner         PengajuanPengeluaran[] @relation("PengajuanOwner")
  returs                 Retur[]
  sessions               Session[]
  stokOprenames          StokOpname[]
  transaksiReviewAudit   TransaksiReviewAudit[] @relation("TransaksiReviewAuditKasir")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model RateLimit {
  key     String   @id
  hit     Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limit")
}

model NomorHarian {
  kunci String @id
  nilai Int    @default(0)

  @@map("nomor_harian")
}

model Kategori {
  id        String   @id @default(cuid())
  nama      String
  deskripsi String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  produk    Produk[]
}

model Bahan {
  id              String           @id @default(cuid())
  nama            String
  satuan          String
  jenis           String?
  stok            Decimal          @default(0) @db.Decimal(14, 2)
  stokMinimum     Decimal          @default(0) @db.Decimal(14, 2)
  hargaSatuan     Decimal          @default(0) @db.Decimal(14, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  pembelian       PembelianBahan[]
  resep           ProdukBahan[]
  stokOpnameItems StokOpnameItem[]
}

model PembelianBahan {
  id               String             @id @default(cuid())
  bahanId          String
  jumlah           Decimal            @db.Decimal(14, 2)
  hargaSatuan      Decimal            @db.Decimal(14, 2)
  totalHarga       Decimal            @db.Decimal(14, 2)
  tanggal          DateTime           @default(now())
  catatan          String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  supplierId       String?
  belumDibayar     Decimal            @default(0) @db.Decimal(14, 2)
  sumberBelanja    String             @default("SUPPLIER")
  tempatBelanja    String?
  bahan            Bahan              @relation(fields: [bahanId], references: [id], onDelete: Cascade)
  supplier         Supplier?          @relation(fields: [supplierId], references: [id])
  pembayaranHutang PembayaranHutang[]

  @@index([bahanId])
  @@index([supplierId])
  @@index([tanggal])
  @@index([sumberBelanja])
  @@index([supplierId, sumberBelanja, tanggal])
}

model Supplier {
  id               String             @id @default(cuid())
  nama             String
  kontak           String?
  alamat           String?
  aktif            Boolean            @default(true)
  catatan          String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  pembelian        PembelianBahan[]
  pembayaranHutang PembayaranHutang[]
}

model PembayaranHutang {
  id               String         @id @default(cuid())
  supplierId       String
  pembelianBahanId String
  jumlah           Decimal        @db.Decimal(14, 2)
  tanggal          DateTime       @default(now())
  catatan          String?
  createdAt        DateTime       @default(now())
  pembelianBahan   PembelianBahan @relation(fields: [pembelianBahanId], references: [id], onDelete: Cascade)
  supplier         Supplier       @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([pembelianBahanId])
  @@index([tanggal])
  @@map("pembayaran_hutang")
}

model Produk {
  id                 String               @id @default(cuid())
  nama               String
  sku                String?              @unique
  barcode            String?              @unique
  gambar             String?
  harga              Decimal              @db.Decimal(14, 2)
  stok               Int                  @default(0)
  aktif              Boolean              @default(true)
  kategoriId         String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  kategori           Kategori?            @relation(fields: [kategoriId], references: [id])
  resep              ProdukBahan[]
  produkModifierGrup ProdukModifierGrup[]
  item               TransaksiItem[]
  returItems         ReturItem[]
  stokOpnameItems    StokOpnameItem[]

  @@index([aktif])
  @@index([kategoriId])
  @@index([nama])
  @@index([deletedAt])
}

model ProdukBahan {
  produkId String
  bahanId  String
  jumlah   Decimal @db.Decimal(14, 2)
  bahan    Bahan   @relation(fields: [bahanId], references: [id])
  produk   Produk  @relation(fields: [produkId], references: [id], onDelete: Cascade)

  @@id([produkId, bahanId])
}

model Member {
  id           String        @id @default(cuid())
  nama         String
  telepon      String?       @unique
  email        String?
  alamat       String?
  poin         Int           @default(0)
  totalBelanja Decimal       @default(0) @db.Decimal(14, 2)
  diskonPersen Decimal?      @db.Decimal(5, 2)
  tier         TierMember    @default(BRONZE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transaksi    Transaksi[]
  pesananDraf  PesananDraf[]

  @@index([email])
  @@index([nama])
}

model Delivery {
  id        String      @id @default(cuid())
  nama      String
  tarif     Decimal     @db.Decimal(14, 2)
  estimasi  String?
  aktif     Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  transaksi Transaksi[]
}

model Transaksi {
  id                   String                 @id @default(cuid())
  nomor                String                 @unique
  tanggal              DateTime               @default(now())
  memberId             String?
  kasirId              String?
  deliveryId           String?
  ongkir               Decimal                @default(0) @db.Decimal(14, 2)
  subtotal             Decimal                @db.Decimal(14, 2)
  diskon               Decimal                @default(0) @db.Decimal(14, 2)
  pajak                Decimal                @default(0) @db.Decimal(14, 2)
  pajakJenis           String?
  total                Decimal                @db.Decimal(14, 2)
  poinPakai            Int                    @default(0)
  poinDapat            Int                    @default(0)
  metodeBayar          MetodeBayar            @default(TUNAI)
  catatan              String?
  mejaId               String?
  statusPesanan        StatusPesanan          @default(MENUNGGU)
  uangDiterima         Decimal?               @db.Decimal(14, 2)
  kembalian            Decimal?               @db.Decimal(14, 2)
  cetakOwner           Int                    @default(0)
  cetakKasir           Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  shiftId              String?
  dibuatOffline        Boolean                @default(false)
  diskonMember         Decimal                @default(0) @db.Decimal(14, 2)
  hpp                  Decimal                @default(0) @db.Decimal(14, 2)
  idempotencyKey       String?                @unique
  waktuKlien           DateTime?
  dibayarPada          DateTime?
  dibayarVia           ViaPembayaran?
  paymentRef           String?                @unique
  stokTerpotong        Boolean                @default(false)
  sumber               SumberTransaksi        @default(POS)
  diterimaPada         DateTime               @default(now())
  alamat               String?
  statusKasirReview    String                 @default("PENDING")
  deletedAt            DateTime?
  jurnal               Jurnal?
  pembayaran           Pembayaran[]
  printJobs            PrintJob[]
  delivery             Delivery?              @relation(fields: [deliveryId], references: [id])
  kasir                User?                  @relation(fields: [kasirId], references: [id])
  meja                 Meja?                  @relation(fields: [mejaId], references: [id])
  member               Member?                @relation(fields: [memberId], references: [id])
  shift                Shift?                 @relation(fields: [shiftId], references: [id])
  items                TransaksiItem[]
  draftHasil           DraftTransaksi?        @relation("DraftTransaksiHasil")
  pesananDraf          PesananDraf?
  returs               Retur[]
  transaksiReviewAudit TransaksiReviewAudit[] @relation("TransaksiReviewAuditTransaksi")

  @@index([tanggal])
  @@index([memberId])
  @@index([kasirId])
  @@index([shiftId])
  @@index([deliveryId])
  @@index([mejaId])
  @@index([metodeBayar])
  @@index([statusPesanan])
  @@index([statusPesanan, createdAt])
  @@index([tanggal, kasirId])
  @@index([sumber, dibayarPada])
  @@index([memberId, tanggal])
  @@index([deletedAt])
  @@index([createdAt], map: "Transaksi_kadaluarsa_idx", where: raw("((\"dibayarPada\" IS NULL) AND (\"statusPesanan\" = ANY (ARRAY['MENUNGGU'::\"StatusPesanan\", 'DIPROSES'::\"StatusPesanan\"])))"))
  @@index([tanggal], map: "Transaksi_terjual_tanggal_idx", where: raw("((\"dibayarPada\" IS NOT NULL) AND (\"statusPesanan\" <> 'DIBATALKAN'::\"StatusPesanan\"))"))
}

model TransaksiItem {
  id          String                  @id @default(cuid())
  transaksiId String
  produkId    String?
  namaProduk  String
  harga       Decimal                 @db.Decimal(14, 2)
  qty         Int
  subtotal    Decimal                 @db.Decimal(14, 2)
  produk      Produk?                 @relation(fields: [produkId], references: [id])
  transaksi   Transaksi               @relation(fields: [transaksiId], references: [id], onDelete: Cascade)
  modifiers   TransaksiItemModifier[]
  returItems  ReturItem[]

  @@index([transaksiId])
  @@index([produkId])
  @@index([produkId, qty])
}

model Pembayaran {
  id           String      @id @default(cuid())
  transaksiId  String
  metode       MetodeBayar
  jumlah       Decimal     @db.Decimal(14, 2)
  uangDiterima Decimal?    @db.Decimal(14, 2)
  createdAt    DateTime    @default(now())
  transaksi    Transaksi   @relation(fields: [transaksiId], references: [id], onDelete: Cascade)

  @@index([transaksiId])
  @@index([metode])
}

model Shift {
  id         String      @id @default(cuid())
  // Unik parsial "satu shift terbuka per kasir" ditegakkan index SQL
  // Shift_kasir_terbuka_key (WHERE waktuTutup IS NULL). Sengaja tidak memakai
  // @unique di sini: Prisma akan menganggap kasirId unik penuh dan mengubah
  // relasi jadi 1:1 serta salah menyusun ON CONFLICT.
  kasirId    String
  waktuBuka  DateTime    @default(now())
  waktuTutup DateTime?
  kasAwal    Decimal     @db.Decimal(14, 2)
  kasAkhir   Decimal?    @db.Decimal(14, 2)
  selisih    Decimal?    @db.Decimal(14, 2)
  catatan    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  kasir      User        @relation(fields: [kasirId], references: [id])
  transaksi  Transaksi[]

  @@index([kasirId])
  @@index([waktuBuka])
}

model Akun {
  id        String         @id @default(cuid())
  kode      String         @unique
  nama      String
  tipe      TipeAkun
  aktif     Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  entri     JurnalDetail[]
}

model Jurnal {
  id                    String                 @id @default(cuid())
  nomor                 String                 @unique
  tanggal               DateTime               @default(now())
  keterangan            String?
  transaksiId           String?                @unique
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  transaksi             Transaksi?             @relation(fields: [transaksiId], references: [id])
  entri                 JurnalDetail[]
  pengajuanPengeluarans PengajuanPengeluaran[]

  @@index([tanggal])
}

model JurnalDetail {
  id         String   @id @default(cuid())
  jurnalId   String
  akunId     String
  debit      Decimal  @default(0) @db.Decimal(14, 2)
  kredit     Decimal  @default(0) @db.Decimal(14, 2)
  keterangan String?
  createdAt  DateTime @default(now())
  akun       Akun     @relation(fields: [akunId], references: [id])
  jurnal     Jurnal   @relation(fields: [jurnalId], references: [id], onDelete: Cascade)

  @@index([jurnalId])
  @@index([akunId])
}

model Pengaturan {
  kunci     String   @id
  nilai     String
  updatedAt DateTime @updatedAt
}

model Meja {
  id          String        @id @default(cuid())
  nomor       String        @unique
  nama        String?
  aktif       Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  transaksi   Transaksi[]
  pesananDraf PesananDraf[]

  @@index([deletedAt])
}

model ModifierGrup {
  id        String               @id @default(cuid())
  nama      String
  wajib     Boolean              @default(false)
  min       Int                  @default(0)
  max       Int                  @default(99)
  aktif     Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  modifiers Modifier[]
  produks   ProdukModifierGrup[]
}

model Modifier {
  id            String                  @id @default(cuid())
  grupId        String
  nama          String
  hargaTambahan Decimal                 @default(0) @db.Decimal(14, 2)
  aktif         Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  grup          ModifierGrup            @relation(fields: [grupId], references: [id], onDelete: Cascade)
  itemTransaksi TransaksiItemModifier[]

  @@index([grupId])
  @@index([aktif])
}

model ProdukModifierGrup {
  id       String       @id @default(cuid())
  produkId String
  grupId   String
  grup     ModifierGrup @relation(fields: [grupId], references: [id], onDelete: Cascade)
  produk   Produk       @relation(fields: [produkId], references: [id], onDelete: Cascade)

  @@unique([produkId, grupId])
  @@index([grupId])
}

model TransaksiItemModifier {
  id              String        @id @default(cuid())
  transaksiItemId String
  modifierId      String
  qty             Int           @default(1)
  catatan         String?
  hargaTambahan   Decimal       @default(0) @db.Decimal(14, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  modifier        Modifier      @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  transaksiItem   TransaksiItem @relation(fields: [transaksiItemId], references: [id], onDelete: Cascade)

  @@index([transaksiItemId])
  @@index([modifierId])
}

model PageVisit {
  id        String   @id @default(cuid())
  path      String
  userId    String?
  userType  String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([path])
  @@index([createdAt])
  @@index([userId])
  @@index([userType])
}

model DeviceVisit {
  id              String   @id @default(cuid())
  deviceId        String   @unique
  deviceName      String?
  os              String
  ipv4            String?
  ipv6            String?
  dns             String?
  lokasi          String?
  klasifikasi     String
  userId          String?
  userType        String
  createdAt       DateTime @default(now())
  terakhirDilihat DateTime @default(now())
  jumlahKunjungan Int      @default(1)
  user            User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([terakhirDilihat])
  @@index([klasifikasi])
  @@index([userType])
}

model Retur {
  id          String      @id @default(cuid())
  nomor       String      @unique
  tanggal     DateTime    @default(now())
  transaksiId String
  kasirId     String
  alasan      String
  totalRetur  Decimal     @db.Decimal(14, 2)
  kasir       User        @relation(fields: [kasirId], references: [id])
  transaksi   Transaksi   @relation(fields: [transaksiId], references: [id])
  items       ReturItem[]

  @@index([transaksiId])
  @@index([kasirId])
  @@index([tanggal])
  @@map("retur")
}

model ReturItem {
  id              String         @id @default(cuid())
  returId         String
  produkId        String?
  namaProduk      String
  qty             Int
  hargaSatuan     Decimal        @db.Decimal(14, 2)
  subtotal        Decimal        @db.Decimal(14, 2)
  transaksiItemId String?
  produk          Produk?        @relation(fields: [produkId], references: [id])
  retur           Retur          @relation(fields: [returId], references: [id], onDelete: Cascade)
  transaksiItem   TransaksiItem? @relation(fields: [transaksiItemId], references: [id])

  @@index([returId])
  @@index([transaksiItemId])
  @@index([produkId])
  @@map("retur_item")
}

model StokOpname {
  id      String           @id @default(cuid())
  nomor   String           @unique
  tanggal DateTime         @default(now())
  kasirId String
  jenis   String
  catatan String?
  kasir   User             @relation(fields: [kasirId], references: [id])
  items   StokOpnameItem[]

  @@index([kasirId])
  @@index([tanggal])
  @@index([jenis])
  @@map("stok_opname")
}

model StokOpnameItem {
  id           String     @id @default(cuid())
  opnameId     String
  produkId     String?
  bahanId      String?
  stokTercatat Decimal    @db.Decimal(14, 2)
  stokFisik    Decimal    @db.Decimal(14, 2)
  selisih      Decimal    @db.Decimal(14, 2)
  bahan        Bahan?     @relation(fields: [bahanId], references: [id])
  opname       StokOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  produk       Produk?    @relation(fields: [produkId], references: [id])

  @@index([opnameId])
  @@index([produkId])
  @@index([bahanId])
  @@map("stok_opname_item")
}

model Printer {
  id              String     @id @default(cuid())
  nama            String
  tipe            String     @default("ESC_POS")
  lokasi          String?
  perangkat       String?
  // Unik parsial (satu default global, satu default per pengguna) dibuat di
  // migrasi SQL. Tidak ditandai @unique agar Prisma tidak menganggap nilai ini
  // unik penuh — findUnique/upsert pada kolom parsial akan gagal (42P10).
  default         Boolean    @default(false)
  aktif           Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  userId          String?
  koneksi         String     @default("USB")
  vendorId        String?
  vendorName      String?
  serialNumber    String?
  productName     String?
  dipindaiPada    DateTime?
  defaultPengguna Boolean    @default(false)
  terakhirDipakai DateTime?
  jobs            PrintJob[]
  user            User?      @relation(fields: [userId], references: [id])

  @@unique([userId, perangkat])
  @@index([userId, aktif, dipindaiPada])
  @@index([koneksi])
}

model PrintJob {
  id             String     @id @default(cuid())
  printerId      String?
  transaksiId    String?
  tipe           String     @default("STRUK")
  status         String     @default("MENUNGGU")
  idempotencyKey String?    @unique
  payload        Json?
  percobaan      Int        @default(0)
  pesanGalat     String?
  dicetakPada    DateTime?
  diambilPada    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  printer        Printer?   @relation(fields: [printerId], references: [id])
  transaksi      Transaksi? @relation(fields: [transaksiId], references: [id])

  @@index([status, printerId])
  @@index([transaksiId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  timestamp DateTime @default(now())
  catatan   String?
  user      User?    @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
  @@index([entity])
  @@map("audit_log")
}

model PengajuanPengeluaran {
  id               String           @id @default(cuid())
  kasirId          String
  ownerId          String?
  nominal          Decimal          @db.Decimal(14, 2)
  jenis            JenisPengeluaran
  keterangan       String?
  status           StatusPengajuan  @default(PENDING)
  alasanPenolakan  String?
  jurnalId         String?
  disetujuiPada    DateTime?
  ditolakPada      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  nominalDisetujui Decimal?         @db.Decimal(14, 2)
  jurnal           Jurnal?          @relation(fields: [jurnalId], references: [id])
  kasir            User             @relation(fields: [kasirId], references: [id], onDelete: Cascade)
  owner            User?            @relation("PengajuanOwner", fields: [ownerId], references: [id])

  @@index([kasirId])
  @@index([status])
  @@index([createdAt])
  @@map("pengajuan_pengeluaran")
}

model DraftTransaksi {
  id             String                 @id @default(cuid())
  nomor          String                 @unique
  kasirId        String
  subtotal       Decimal                @db.Decimal(14, 2)
  total          Decimal                @db.Decimal(14, 2)
  metodeBayar    String
  catatan        String?
  waktuKlien     DateTime?
  dibuatOffline  Boolean                @default(false)
  idempotencyKey String?                @unique
  status         StatusDraftTransaksi   @default(MENUNGGU)
  reviewedById   String?
  reviewedAt     DateTime?
  transaksiId    String?                @unique
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  payloadJson    Json
  kasir          User                   @relation("DraftTransaksiKasir", fields: [kasirId], references: [id])
  reviewedBy     User?                  @relation("DraftTransaksiReviewer", fields: [reviewedById], references: [id])
  transaksi      Transaksi?             @relation("DraftTransaksiHasil", fields: [transaksiId], references: [id])
  reviewAudits   TransaksiReviewAudit[] @relation("TransaksiReviewAuditDraft")

  @@index([kasirId])
  @@index([status])
  @@index([createdAt])
  @@map("draft_transaksi")
}

model TransaksiReviewAudit {
  id          String          @id @default(cuid())
  transaksiId String?
  kasirId     String
  status      String
  catatan     String?
  createdAt   DateTime        @default(now())
  draftId     String?
  draft       DraftTransaksi? @relation("TransaksiReviewAuditDraft", fields: [draftId], references: [id])
  kasir       User            @relation("TransaksiReviewAuditKasir", fields: [kasirId], references: [id])
  transaksi   Transaksi?      @relation("TransaksiReviewAuditTransaksi", fields: [transaksiId], references: [id])

  @@index([draftId])
  @@index([transaksiId])
  @@index([kasirId])
  @@index([createdAt])
  @@map("transaksi_review_audit")
}

model PesananDraf {
  id             String            @id @default(cuid())
  mejaId         String?
  memberId       String?
  nama           String?
  telepon        String?
  catatan        String?
  status         StatusPesananDraf @default(MENUNGGU)
  itemsJson      Json
  subtotal       Decimal           @db.Decimal(14, 2)
  finalisasiPada DateTime?
  transaksiId    String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  meja           Meja?             @relation(fields: [mejaId], references: [id])
  member         Member?           @relation(fields: [memberId], references: [id])
  transaksi      Transaksi?        @relation(fields: [transaksiId], references: [id])

  @@index([mejaId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([finalisasiPada])
  @@map("pesanan_draf")
}

model Notifikasi {
  id        String   @id @default(cuid())
  userId    String
  judul     String
  pesan     String
  dibaca    Boolean  @default(false)
  tipe      String
  entitasId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([dibaca])
  @@index([createdAt])
  @@map("notifikasi")
}

